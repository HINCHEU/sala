# Defaults match docker-compose.yml, so `cp .env.example .env` works for local development.

APP_NAME=Sala
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# Base domain for school subdomains, e.g. sala.test → demo.sala.test. Leave empty to switch schools in the menu.
TENANT_DOMAIN=

# Khmer is the default interface language; English is the fallback for missing keys.
APP_LOCALE=km
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.4 container. utf8mb4_unicode_ci is set in config/database.php so Khmer sorts correctly.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sala
DB_USERNAME=sala
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit in dev: inbox at http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@sala.test"
MAIL_FROM_NAME="${APP_NAME}"

# School files (disks media_private and media_public). MEDIA_DRIVER=local stores under storage/app;
# MEDIA_DRIVER=s3 talks to any S3-compatible store. Dev uses the MinIO container (console http://localhost:9001).
#   DigitalOcean Spaces: MEDIA_REGION=sgp1  MEDIA_ENDPOINT=https://sgp1.digitaloceanspaces.com
#   Cloudflare R2:       MEDIA_REGION=auto  MEDIA_ENDPOINT=https://<account>.r2.cloudflarestorage.com
MEDIA_DRIVER=s3
MEDIA_KEY=sala
MEDIA_SECRET=salasecret
MEDIA_REGION=auto
MEDIA_BUCKET=sala-private
# Bucket for logos; remove the line to share MEDIA_BUCKET.
MEDIA_PUBLIC_BUCKET=sala-public
MEDIA_ENDPOINT=http://minio:9000
# Public base URL for logos (your own domain in production, e.g. https://files.yourapp.com).
MEDIA_PUBLIC_URL=http://localhost:9000/sala-public
# true for MinIO and R2; Spaces works either way.
MEDIA_PATH_STYLE=true

# Nightly mysqldump target (disk "backups"). Use a separate bucket from media. Keep 30 days (bucket lifecycle rule).
BACKUP_KEY=
BACKUP_SECRET=
BACKUP_REGION=auto
BACKUP_BUCKET=
BACKUP_ENDPOINT=
BACKUP_PATH_STYLE=true

# Gotenberg renders Khmer PDFs (headless Chromium). Container name inside Docker.
GOTENBERG_URL=http://gotenberg:3000

# Telegram bot (Phase 2). Token from @BotFather; never commit a real one.
TELEGRAM_BOT_TOKEN=
# Random string Telegram echoes in X-Telegram-Bot-Api-Secret-Token to prove a webhook call is genuine.
TELEGRAM_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
